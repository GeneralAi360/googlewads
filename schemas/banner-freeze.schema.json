{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeneralAi360/googlewads/schemas/banner-freeze.schema.json",
  "title": "Banner Run Freeze",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "freeze_id",
    "run_id",
    "status",
    "frozen_at",
    "google_mode",
    "google_spec_snapshot_date",
    "google_spec_snapshot_source",
    "concept_count",
    "size_count",
    "variant_count",
    "language_count",
    "sizes",
    "languages",
    "output_format",
    "expected_output_files",
    "intake_status",
    "intake_state_counts",
    "intake_context_sha256",
    "matrix_path",
    "matrix_sha256"
  ],
  "properties": {
    "freeze_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"const": "FROZEN"},
    "frozen_at": {"type": "string", "format": "date-time"},
    "google_mode": {"enum": ["demand_gen_uploaded_display", "uploaded_display_general"]},
    "google_spec_snapshot_date": {"type": "string"},
    "google_spec_snapshot_source": {"type": "string"},
    "business_brief_id": {"type": ["string", "null"]},
    "brand_id": {"type": ["string", "null"]},
    "reference_dna_ids": {"type": "array", "items": {"type": "string"}},
    "concept_count": {"type": "integer", "minimum": 1},
    "size_count": {"type": "integer", "minimum": 1},
    "variant_count": {"type": "integer", "minimum": 1},
    "language_count": {"type": "integer", "minimum": 1},
    "sizes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]+x[0-9]+$"}},
    "languages": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "output_format": {"enum": ["png", "jpg"]},
    "expected_output_files": {"type": "integer", "minimum": 1},
    "intake_status": {"const": "READY_TO_FREEZE"},
    "intake_state_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["RESOLVED", "MISSING", "CONDITIONAL", "NOT_APPLICABLE"],
      "properties": {
        "RESOLVED": {"type": "integer", "minimum": 0},
        "MISSING": {"type": "integer", "minimum": 0},
        "CONDITIONAL": {"type": "integer", "minimum": 0},
        "NOT_APPLICABLE": {"type": "integer", "minimum": 0}
      }
    },
    "intake_context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "matrix_path": {"type": "string", "minLength": 1},
    "matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
