{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeneralAi360/googlewads/schemas/category-design-map.schema.json",
  "title": "Category Design Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["category_map_id", "research_id", "research_sha256", "category", "source_creative_ids", "mature_category_signals", "dominant_patterns", "trust_signals", "category_cliches", "generic_ai_risks", "design_opportunities"],
  "properties": {
    "category_map_id": {"type": "string", "minLength": 1},
    "research_id": {"type": "string", "minLength": 1},
    "research_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "category": {"type": "string", "minLength": 1},
    "source_creative_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mature_category_signals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "dominant_patterns": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "hero_strategies": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "trust_signals": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "category_cliches": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "generic_ai_risks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "design_opportunities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "performance_interpretation": {"type": "string", "minLength": 1}
  }
}
