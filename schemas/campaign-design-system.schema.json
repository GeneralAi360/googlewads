{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeneralAi360/googlewads/schemas/campaign-design-system.schema.json",
  "title": "Approved Campaign Design System",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign_design_system_id",
    "status",
    "design_brief_id",
    "design_brief_sha256",
    "art_direction_approval_id",
    "art_direction_approval_sha256",
    "representative_approval_id",
    "representative_approval_sha256",
    "art_direction_id",
    "idea_architecture_id",
    "visual_character_signature_id",
    "lighting_intent_id",
    "grid_logic",
    "headline_behavior",
    "offer_behavior",
    "cta_behavior",
    "brand_anchor_behavior",
    "hero_treatment",
    "crop_language",
    "background_system",
    "accent_system",
    "lighting_system",
    "whitespace_character",
    "format_adaptation_rules",
    "forbidden_patterns"
  ],
  "properties": {
    "campaign_design_system_id": {"type": "string", "minLength": 1},
    "status": {"const": "APPROVED"},
    "design_brief_id": {"type": "string", "minLength": 1},
    "design_brief_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "art_direction_approval_id": {"type": "string", "minLength": 1},
    "art_direction_approval_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "representative_approval_id": {"type": "string", "minLength": 1},
    "representative_approval_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "art_direction_id": {"type": "string", "minLength": 1},
    "idea_architecture_id": {"type": "string", "minLength": 1},
    "visual_character_signature_id": {"type": "string", "minLength": 1},
    "lighting_intent_id": {"type": "string", "minLength": 1},
    "grid_logic": {"type": "string", "minLength": 1},
    "headline_behavior": {"type": "string", "minLength": 1},
    "offer_behavior": {"type": "string", "minLength": 1},
    "cta_behavior": {"type": "string", "minLength": 1},
    "brand_anchor_behavior": {"type": "string", "minLength": 1},
    "hero_treatment": {"type": "string", "minLength": 1},
    "crop_language": {"type": "string", "minLength": 1},
    "background_system": {"type": "string", "minLength": 1},
    "accent_system": {"type": "string", "minLength": 1},
    "lighting_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_policy", "composition_policy", "focal_priority", "copy_safe_policy", "allowed_primitives", "forbidden_behaviors"],
      "properties": {
        "scene_policy": {"type": "string", "minLength": 1},
        "composition_policy": {"type": "string", "minLength": 1},
        "focal_priority": {"type": "string", "minLength": 1},
        "copy_safe_policy": {"type": "string", "minLength": 1},
        "allowed_primitives": {"type": "array", "uniqueItems": true, "items": {"enum": ["hero_edge_glow", "spotlight", "copy_scrim", "vignette", "text_plate"]}},
        "forbidden_behaviors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "whitespace_character": {"type": "string", "minLength": 1},
    "format_adaptation_rules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "forbidden_patterns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "notes": {"type": ["string", "null"]}
  }
}
