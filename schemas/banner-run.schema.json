{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeneralAi360/googlewads/schemas/banner-run.schema.json",
  "title": "Banner Run Composite Snapshot (Legacy Compatibility)",
  "description": "Compatibility schema for a composite run snapshot. The canonical v0.2 production source of truth is split across banner-freeze.schema.json, banner-matrix.schema.json, creative-contract.schema.json, render specs, output manifest and review schemas. Do not use this composite document to bypass those freeze/binding gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "google_mode",
    "concept_count",
    "sizes",
    "variant_count",
    "languages",
    "expected_output_files",
    "creative_contracts",
    "banner_matrix"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "google_mode": {
      "type": "string",
      "enum": ["demand_gen_assets", "responsive_display_assets", "uploaded_display_static", "html5_planning"]
    },
    "business_brief_id": {"type": ["string", "null"]},
    "brand_id": {"type": ["string", "null"]},
    "reference_dna_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "google_spec_snapshot_id": {"type": ["string", "null"]},
    "concept_count": {"type": "integer", "minimum": 1},
    "sizes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["width", "height"],
        "properties": {
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "layout_family": {"type": ["string", "null"]}
        }
      }
    },
    "variant_count": {"type": "integer", "minimum": 1},
    "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "expected_output_files": {"type": "integer", "minimum": 1},
    "output_math": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula", "concept_count", "size_count", "variant_count", "language_count", "total"],
      "properties": {
        "formula": {"const": "concept_count * size_count * variant_count * language_count"},
        "concept_count": {"type": "integer", "minimum": 1},
        "size_count": {"type": "integer", "minimum": 1},
        "variant_count": {"type": "integer", "minimum": 1},
        "language_count": {"type": "integer", "minimum": 1},
        "total": {"type": "integer", "minimum": 1}
      }
    },
    "creative_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concept_id",
          "primary_proposition",
          "visual_idea",
          "primary_aoi",
          "scan_path",
          "art_direction_id"
        ],
        "properties": {
          "concept_id": {"type": "string", "pattern": "^C[0-9]{2,}$"},
          "primary_proposition": {"type": "string", "minLength": 1},
          "supporting_proof": {"type": ["string", "null"]},
          "visual_idea": {"type": "string", "minLength": 1},
          "primary_aoi": {"type": "string", "minLength": 1},
          "scan_path": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "brand_id": {"type": ["string", "null"]},
          "art_direction_id": {"type": "string", "minLength": 1},
          "reference_dna_ids": {"type": "array", "items": {"type": "string"}},
          "lighting_scheme_id": {"type": ["integer", "null"], "minimum": 1, "maximum": 30},
          "source_grounding_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "banner_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["job_id", "concept_id", "variant_id", "language", "width", "height", "layout_family", "output_path", "status"],
        "properties": {
          "job_id": {"type": "string", "minLength": 1},
          "concept_id": {"type": "string"},
          "variant_id": {"type": "string"},
          "language": {"type": "string"},
          "width": {"type": "integer", "minimum": 1},
          "height": {"type": "integer", "minimum": 1},
          "layout_family": {"type": "string"},
          "hero_asset_id": {"type": ["string", "null"]},
          "reference_dna_ids": {"type": "array", "items": {"type": "string"}},
          "lighting_scheme_id": {"type": ["integer", "null"], "minimum": 1, "maximum": 30},
          "output_path": {"type": "string", "minLength": 1},
          "worker_thread_id": {"type": ["string", "null"]},
          "review_status": {"type": "string", "enum": ["NOT_STARTED", "IN_REVIEW", "PASS", "FAIL", "BLOCKED"]},
          "validation_status": {"type": "string", "enum": ["NOT_STARTED", "PASS", "FAIL", "BLOCKED"]},
          "status": {"type": "string", "enum": ["PLANNED", "DISPATCHED", "GENERATED", "FIX_REQUIRED", "PASS", "BLOCKED"]},
          "blocker": {"type": ["string", "null"]}
        }
      }
    },
    "subagent_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "one_fresh_context_per_banner_job": {"type": "boolean"},
        "allow_parallel_read_only_roles": {"type": "boolean"},
        "allow_parallel_banner_writers_only_with_isolated_paths": {"type": "boolean"},
        "degraded_mode": {"type": "boolean"}
      }
    }
  }
}
