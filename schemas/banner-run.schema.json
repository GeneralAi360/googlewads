{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeneralAi360/googlewads/schemas/banner-run.schema.json",
  "title": "Banner Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id","google_mode","concept_count","sizes","variant_count","languages","expected_output_files","creative_contracts","banner_matrix"],
  "properties": {
    "run_id": {"type":"string","minLength":1},
    "google_mode": {"type":"string","enum":["demand_gen_assets","responsive_display_assets","uploaded_display_static","html5_planning"]},
    "business_brief_id":{"type":["string","null"]},
    "brand_id":{"type":["string","null"]},
    "reference_dna_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "google_spec_snapshot_id":{"type":["string","null"]},
    "concept_count":{"type":"integer","minimum":1},
    "sizes":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["width","height"],"properties":{"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"layout_family":{"type":["string","null"]}}}},
    "variant_count":{"type":"integer","minimum":1},
    "languages":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "expected_output_files":{"type":"integer","minimum":1},
    "output_math":{"type":"object","additionalProperties":false,"required":["formula","concept_count","size_count","variant_count","language_count","total"],"properties":{"formula":{"const":"concept_count * size_count * variant_count * language_count"},"concept_count":{"type":"integer","minimum":1},"size_count":{"type":"integer","minimum":1},"variant_count":{"type":"integer","minimum":1},"language_count":{"type":"integer","minimum":1},"total":{"type":"integer","minimum":1}}},
    "creative_contracts":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["concept_id","primary_proposition","cta","visual_idea","primary_aoi","scan_path"],"properties":{"concept_id":{"type":"string","pattern":"^C[0-9]{2,}$"},"hook":{"type":["string","null"]},"primary_proposition":{"type":"string","minLength":1},"supporting_proof":{"type":["string","null"]},"cta":{"type":"string","minLength":1},"visual_idea":{"type":"string","minLength":1},"primary_aoi":{"type":"string","minLength":1},"scan_path":{"type":"array","minItems":1,"items":{"type":"string"}},"reference_dna_ids":{"type":"array","items":{"type":"string"}},"lighting_scheme_id":{"type":["integer","null"],"minimum":1,"maximum":30},"source_grounding":{"type":"array","items":{"type":"string"}},"test_hypothesis":{"type":["string","null"]}}}},
    "banner_matrix":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["job_id","concept_id","variant_id","language","width","height","layout_family","output_path","status"],"properties":{"job_id":{"type":"string","minLength":1},"concept_id":{"type":"string"},"variant_id":{"type":"string"},"language":{"type":"string"},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"layout_family":{"type":"string"},"headline":{"type":["string","null"]},"offer":{"type":["string","null"]},"support":{"type":["string","null"]},"cta":{"type":["string","null"]},"hero_asset_id":{"type":["string","null"]},"reference_dna_ids":{"type":"array","items":{"type":"string"}},"lighting_scheme_id":{"type":["integer","null"],"minimum":1,"maximum":30},"output_path":{"type":"string","minLength":1},"worker_thread_id":{"type":["string","null"]},"review_status":{"type":"string","enum":["NOT_STARTED","IN_REVIEW","PASS","FAIL","BLOCKED"]},"validation_status":{"type":"string","enum":["NOT_STARTED","PASS","FAIL","BLOCKED"]},"status":{"type":"string","enum":["PLANNED","DISPATCHED","GENERATED","FIX_REQUIRED","PASS","BLOCKED"]},"blocker":{"type":["string","null"]}}}},
    "subagent_policy":{"type":"object","additionalProperties":false,"properties":{"one_fresh_context_per_banner_job":{"type":"boolean"},"allow_parallel_read_only_roles":{"type":"boolean"},"allow_parallel_banner_writers_only_with_isolated_paths":{"type":"boolean"},"degraded_mode":{"type":"boolean"}}}
  }
}