{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeneralAi360/googlewads/schemas/art-direction-approval.schema.json",
  "title": "Internal Written Art Direction Freeze",
  "description": "Internal preproduction selection/freeze. It is not the user's visual approval and cannot unlock full production without an approved rendered representative visual concept.",
  "type": "object",
  "additionalProperties": false,
  "required": ["approval_id", "status", "approved_by", "design_brief_id", "design_brief_sha256", "selected_direction"],
  "properties": {
    "approval_id": {"type": "string", "minLength": 1},
    "status": {"const": "APPROVED"},
    "approved_by": {"enum": ["BRAND_SYSTEM", "ART_DIRECTOR_REVIEWER"]},
    "approved_at": {"type": ["string", "null"]},
    "design_brief_id": {"type": "string", "minLength": 1},
    "design_brief_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "art_direction_id",
        "label",
        "candidate_ids",
        "style_strategy_id",
        "style_strategy_lane",
        "style_recommendation_sha256",
        "style_library_snapshot_date",
        "style_components",
        "idea_architecture_id",
        "visual_character_signature_id",
        "lighting_intent_id",
        "presentation_mode",
        "emotional_target",
        "visual_thesis",
        "composition",
        "hero_strategy",
        "typography",
        "palette",
        "lighting_image_treatment",
        "graphic_device",
        "trust_signals",
        "whitespace_character",
        "anti_patterns"
      ],
      "properties": {
        "art_direction_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "style_strategy_id": {"type": "string", "minLength": 1},
        "style_strategy_lane": {"enum": ["SAFE_STRONG", "CURRENT_DIFFERENTIATED", "CONTROLLED_WILDCARD", "USER_SUPPLIED_LOCKED"]},
        "style_recommendation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "style_library_snapshot_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "style_components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["foundation_id", "overlay_id", "execution_id", "attention_id", "typography_id"],
          "properties": {
            "foundation_id": {"type": "string", "minLength": 1},
            "overlay_id": {"type": ["string", "null"]},
            "execution_id": {"type": "string", "minLength": 1},
            "attention_id": {"type": "string", "minLength": 1},
            "typography_id": {"type": "string", "minLength": 1}
          }
        },
        "idea_architecture_id": {"type": "string", "minLength": 1},
        "visual_character_signature_id": {"type": "string", "minLength": 1},
        "lighting_intent_id": {"type": "string", "minLength": 1},
        "presentation_mode": {"type": "string", "minLength": 1},
        "emotional_target": {"type": "string", "minLength": 1},
        "visual_thesis": {"type": "string", "minLength": 1},
        "composition": {"type": "string", "minLength": 1},
        "hero_strategy": {"type": "string", "minLength": 1},
        "typography": {"type": "string", "minLength": 1},
        "palette": {"type": "string", "minLength": 1},
        "lighting_image_treatment": {"type": "string", "minLength": 1},
        "graphic_device": {"type": "string", "minLength": 1},
        "trust_signals": {"type": "array", "items": {"type": "string"}},
        "whitespace_character": {"type": "string", "minLength": 1},
        "anti_patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "notes": {"type": ["string", "null"]}
  }
}
