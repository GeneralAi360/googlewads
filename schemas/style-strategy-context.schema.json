{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeneralAi360/googlewads/schemas/style-strategy-context.schema.json",
  "title": "Style Strategy Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_id",
    "category_tags",
    "presentation_mode",
    "primary_emotion",
    "target_order_to_virality",
    "target_aesthetics_to_innovation",
    "disruption_level",
    "hero_type",
    "asset_truth_mode",
    "layout_families",
    "language_scripts",
    "brand_traits",
    "avoid_tags",
    "currentness_preference",
    "typography_goal"
  ],
  "properties": {
    "context_id": {"type":"string","minLength":1},
    "category_tags": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "presentation_mode": {"type":"string","minLength":1},
    "primary_emotion": {"type":"string","minLength":1},
    "secondary_emotions": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "avoid_emotions": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "target_order_to_virality": {"type":"number","minimum":0,"maximum":1},
    "target_aesthetics_to_innovation": {"type":"number","minimum":0,"maximum":1},
    "disruption_level": {"enum":["LOW","MEDIUM","HIGH"]},
    "hero_type": {"type":"string","minLength":1},
    "asset_truth_mode": {"enum":["REAL_ASSET","GENERATED","HYBRID","TYPE_ONLY","OTHER"]},
    "layout_families": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "language_scripts": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "brand_traits": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "avoid_tags": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "category_cliches": {"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "currentness_preference": {"enum":["EVERGREEN","BALANCED","CURRENT","EXPERIMENTAL_BALANCED"]},
    "typography_goal": {"enum":["ENTERPRISE","EDITORIAL","PREMIUM","PROMO","HUMAN","TECHNICAL","EXPRESSIVE","LOCAL","AUTO"]},
    "notes": {"type":["string","null"]}
  }
}
