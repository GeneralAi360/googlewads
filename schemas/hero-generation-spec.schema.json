{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeneralAi360/googlewads/schemas/hero-generation-spec.schema.json",
  "title": "Hero Generation Specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hero_generation_spec_id",
    "status",
    "design_brief_id",
    "design_brief_sha256",
    "art_direction_id",
    "idea_architecture_id",
    "visual_character_signature_id",
    "lighting_intent_id",
    "purpose",
    "format",
    "subject",
    "environment",
    "composition",
    "lighting",
    "visual_character",
    "details",
    "forbidden_elements",
    "generated_text_allowed",
    "generated_logo_allowed"
  ],
  "properties": {
    "hero_generation_spec_id": {"type": "string", "minLength": 1},
    "status": {"const": "READY_FOR_GENERATION"},
    "design_brief_id": {"type": "string", "minLength": 1},
    "design_brief_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "art_direction_id": {"type": "string", "minLength": 1},
    "idea_architecture_id": {"type": "string", "minLength": 1},
    "visual_character_signature_id": {"type": "string", "minLength": 1},
    "lighting_intent_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect_ratio", "source_width", "source_height", "target_role"],
      "properties": {
        "aspect_ratio": {"type": "string", "minLength": 1},
        "source_width": {"type": "integer", "minimum": 1},
        "source_height": {"type": "integer", "minimum": 1},
        "target_role": {"enum": ["REPRESENTATIVE_HERO", "FORMAT_HERO", "BACKGROUND", "OTHER"]}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_object", "state_or_action", "scale"],
      "properties": {
        "primary_object": {"type": "string", "minLength": 1},
        "state_or_action": {"type": "string", "minLength": 1},
        "scale": {"type": "string", "minLength": 1},
        "material_notes": {"type": ["string", "null"]}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "context"],
      "properties": {
        "background": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1}
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focal_point", "camera_angle", "orientation", "copy_safe_zone", "crop_intent"],
      "properties": {
        "focal_point": {"type": "string", "minLength": 1},
        "camera_angle": {"type": "string", "minLength": 1},
        "orientation": {"type": "string", "minLength": 1},
        "copy_safe_zone": {"type": "string", "minLength": 1},
        "crop_intent": {"type": "string", "minLength": 1}
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_mode", "selected_scheme_id", "direction", "contrast", "rationale", "protect_copy_safe_zone"],
      "properties": {
        "scene_mode": {"enum": ["REQUIRED", "OPTIONAL"]},
        "selected_scheme_id": {"type": ["integer", "null"], "minimum": 1, "maximum": 30},
        "direction": {"type": "string", "minLength": 1},
        "contrast": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "protect_copy_safe_zone": {"type": "boolean"}
      }
    },
    "visual_character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_character", "emotion", "palette_behavior", "disruption_level"],
      "properties": {
        "primary_character": {"type": "string", "minLength": 1},
        "emotion": {"type": "string", "minLength": 1},
        "palette_behavior": {"type": "string", "minLength": 1},
        "disruption_level": {"enum": ["LOW", "MEDIUM", "HIGH"]}
      }
    },
    "details": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "forbidden_elements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "generated_text_allowed": {"const": false},
    "generated_logo_allowed": {"const": false},
    "provider_notes": {"type": ["string", "null"]}
  }
}
