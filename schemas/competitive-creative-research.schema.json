{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeneralAi360/googlewads/schemas/competitive-creative-research.schema.json",
  "title": "Competitive Creative Research",
  "type": "object",
  "additionalProperties": false,
  "required": ["research_id", "status", "coverage_status", "category", "creatives", "synthesis"],
  "properties": {
    "research_id": {"type": "string", "minLength": 1},
    "status": {"const": "COMPETITIVE_RESEARCH_COMPLETE"},
    "coverage_status": {"enum": ["FULL", "DEGRADED"]},
    "degradation_reason": {"type": ["string", "null"]},
    "category": {"type": "string", "minLength": 1},
    "queries": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "creatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["creative_id", "advertiser", "source_type", "source_url", "creative_type", "commercial_angle", "visual_system", "performance_evidence", "transferable_principles", "do_not_copy"],
        "properties": {
          "creative_id": {"type": "string", "minLength": 1},
          "advertiser": {"type": "string", "minLength": 1},
          "source_type": {"enum": ["GOOGLE_ADS_TRANSPARENCY", "LINKEDIN_AD_LIBRARY", "TIKTOK_TOP_ADS", "OWN_PERFORMANCE", "PUBLISHED_CASE", "FOREPLAY", "ADPLEXITY", "MOTION", "COMPETITOR_SITE", "OTHER"]},
          "source_url": {"type": "string", "minLength": 1},
          "observed_at": {"type": ["string", "null"]},
          "creative_type": {"type": "string", "minLength": 1},
          "commercial_angle": {"type": "string", "minLength": 1},
          "visual_system": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hero_type", "composition", "typography", "palette_contrast", "cta_treatment", "whitespace_density", "trust_signals", "image_treatment"],
            "properties": {
              "hero_type": {"type": "string", "minLength": 1},
              "composition": {"type": "string", "minLength": 1},
              "typography": {"type": "string", "minLength": 1},
              "palette_contrast": {"type": "string", "minLength": 1},
              "cta_treatment": {"type": "string", "minLength": 1},
              "whitespace_density": {"type": "string", "minLength": 1},
              "trust_signals": {"type": "array", "items": {"type": "string"}},
              "image_treatment": {"type": "string", "minLength": 1},
              "lighting": {"type": ["string", "null"]}
            }
          },
          "performance_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tier", "note"],
            "properties": {
              "tier": {"enum": ["A_VERIFIED_OWN_METRICS", "B_PUBLISHED_CASE_METRICS", "C_PLATFORM_PERFORMANCE_SIGNAL", "D_MARKET_PROXY", "E_DESIGN_REFERENCE_ONLY"]},
              "note": {"type": "string", "minLength": 1},
              "metrics": {"type": "object", "additionalProperties": {"type": ["number", "string"]}},
              "conversion_metric_verified": {"type": "boolean"}
            }
          },
          "transferable_principles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "do_not_copy": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "synthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commercial_patterns", "visual_patterns", "trust_patterns", "category_cliches", "opportunities"],
      "properties": {
        "commercial_patterns": {"type": "array", "items": {"type": "string"}},
        "visual_patterns": {"type": "array", "items": {"type": "string"}},
        "trust_patterns": {"type": "array", "items": {"type": "string"}},
        "category_cliches": {"type": "array", "items": {"type": "string"}},
        "opportunities": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
