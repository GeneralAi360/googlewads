{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeneralAi360/googlewads/schemas/banner-render-spec.schema.json",
  "title": "Deterministic Banner Render Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "width", "height", "layout_family", "copy", "brand", "output"],
  "properties": {
    "schema_version": {"type": "string"},
    "job_id": {"type": "string", "minLength": 1},
    "width": {"type": "integer", "minimum": 1},
    "height": {"type": "integer", "minimum": 1},
    "layout_family": {"type": "string", "minLength": 1},
    "background": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"color": {"$ref": "#/$defs/color"}}
    },
    "hero": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "mode": {"type": "string", "enum": ["slot", "full_bleed", "full_bleed_optional"]},
        "focal_point": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "logo": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "brand_name": {"type": "string"},
        "clearspace_px": {"type": "integer", "minimum": 0},
        "clearspace_ratio": {"type": "number", "minimum": 0, "exclusiveMaximum": 0.5}
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headline": {"type": ["string", "null"]},
        "support": {"type": ["string", "null"]},
        "offer": {"type": ["string", "null"]},
        "cta": {"type": ["string", "null"]}
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font_regular": {"type": ["string", "null"]},
        "font_bold": {"type": ["string", "null"]},
        "text_color": {"$ref": "#/$defs/color"},
        "muted_text_color": {"$ref": "#/$defs/color"},
        "accent_color": {"$ref": "#/$defs/color"},
        "cta_fill": {"$ref": "#/$defs/color"},
        "cta_text": {"$ref": "#/$defs/color"},
        "cta_radius_px": {"type": "integer", "minimum": 0},
        "offer_fill": {"$ref": "#/$defs/color"},
        "offer_text": {"$ref": "#/$defs/color"},
        "offer_radius_px": {"type": "integer", "minimum": 0}
      }
    },
    "lighting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "copy_scrim": {"$ref": "#/$defs/scrim"},
        "spotlight": {"$ref": "#/$defs/spotlight"},
        "vignette": {"$ref": "#/$defs/vignette"},
        "hero_edge_glow": {"$ref": "#/$defs/heroGlow"},
        "text_plate": {"$ref": "#/$defs/textPlate"}
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_cta_contrast": {"type": "number", "minimum": 1, "maximum": 21},
        "min_flat_text_contrast": {"type": "number", "minimum": 1, "maximum": 21},
        "min_local_text_contrast": {"type": "number", "minimum": 1, "maximum": 21}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "format": {"type": "string", "enum": ["png", "jpg", "jpeg"]},
        "target_max_bytes": {"type": "integer", "minimum": 1000},
        "jpeg_quality": {"type": "integer", "minimum": 20, "maximum": 100},
        "min_jpeg_quality": {"type": "integer", "minimum": 20, "maximum": 100}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brand_id": {"type": ["string", "null"]},
        "creative_contract_id": {"type": ["string", "null"]},
        "creative_contract_path": {"type": ["string", "null"]},
        "creative_contract_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "hero_asset_id": {"type": ["string", "null"]},
        "reference_dna_ids": {"type": "array", "items": {"type": "string"}},
        "source_grounding_ids": {"type": "array", "items": {"type": "string"}},
        "lighting_scheme_id": {"type": ["integer", "null"], "minimum": 1, "maximum": 30}
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slots": {"type": "object", "additionalProperties": {"$ref": "#/$defs/slot"}},
        "text": {"type": "object", "additionalProperties": {"$ref": "#/$defs/textRule"}}
      }
    }
  },
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"},
    "slot": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "textRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_px": {"type": "integer", "minimum": 1},
        "max_px": {"type": "integer", "minimum": 1},
        "max_lines": {"type": "integer", "minimum": 1}
      }
    },
    "scrim": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "side": {"type": "string", "enum": ["left", "right", "top", "bottom"]},
        "color": {"$ref": "#/$defs/color"},
        "max_opacity": {"type": "integer", "minimum": 0, "maximum": 255},
        "extent": {"type": "number", "minimum": 0.05, "maximum": 1}
      }
    },
    "spotlight": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "center": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "radius": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
        "color": {"$ref": "#/$defs/color"},
        "opacity": {"type": "integer", "minimum": 0, "maximum": 255},
        "blur": {"type": "integer", "minimum": 0}
      }
    },
    "vignette": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "color": {"$ref": "#/$defs/color"},
        "opacity": {"type": "integer", "minimum": 0, "maximum": 255},
        "softness": {"type": "number", "minimum": 0.05, "maximum": 0.95}
      }
    },
    "heroGlow": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "target_slot": {"type": "string"},
        "box": {"$ref": "#/$defs/slot"},
        "color": {"$ref": "#/$defs/color"},
        "opacity": {"type": "integer", "minimum": 0, "maximum": 255},
        "blur": {"type": "integer", "minimum": 0},
        "expand_px": {"type": "integer", "minimum": 0},
        "radius_px": {"type": "integer", "minimum": 0}
      }
    },
    "textPlate": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "target_slots": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "box": {"$ref": "#/$defs/slot"},
        "color": {"$ref": "#/$defs/color"},
        "opacity": {"type": "integer", "minimum": 0, "maximum": 255},
        "radius_px": {"type": "integer", "minimum": 0},
        "padding_px": {"type": "integer", "minimum": 0}
      }
    }
  }
}
