{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeneralAi360/googlewads/schemas/style-strategy-recommendation.schema.json",
  "title": "Style Strategy Recommendation",
  "type": "object",
  "additionalProperties": false,
  "required": ["status","context_id","library_snapshot_date","currentness_status","recommendations","policy"],
  "properties": {
    "status": {"const":"STYLE_STRATEGY_READY"},
    "context_id": {"type":"string","minLength":1},
    "library_snapshot_date": {"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "currentness_status": {"enum":["CURRENT","STALE_CURRENTNESS_DISABLED"]},
    "recommendations": {
      "type":"array",
      "minItems":3,
      "maxItems":3,
      "items": {
        "type":"object",
        "additionalProperties": false,
        "required": ["strategy_id","lane","score_total","components","scores","attention_plan","typography_plan","lighting_affinity","rationale","risk_flags","performance_claim"],
        "properties": {
          "strategy_id": {"type":"string","minLength":1},
          "lane": {"enum":["SAFE_STRONG","CURRENT_DIFFERENTIATED","CONTROLLED_WILDCARD"]},
          "score_total": {"type":"number","minimum":0,"maximum":1},
          "components": {
            "type":"object",
            "additionalProperties": false,
            "required":["foundation_id","overlay_id","execution_id","attention_id","typography_id"],
            "properties": {
              "foundation_id":{"type":"string","minLength":1},
              "overlay_id":{"type":["string","null"]},
              "execution_id":{"type":"string","minLength":1},
              "attention_id":{"type":"string","minLength":1},
              "typography_id":{"type":"string","minLength":1}
            }
          },
          "scores": {
            "type":"object",
            "additionalProperties": false,
            "required":["presentation_fit","category_fit","emotion_fit","attention_fit","typography_fit","asset_truth_fit","format_resilience","lighting_fit","currentness"],
            "properties": {
              "presentation_fit":{"type":"number","minimum":0,"maximum":1},
              "category_fit":{"type":"number","minimum":0,"maximum":1},
              "emotion_fit":{"type":"number","minimum":0,"maximum":1},
              "attention_fit":{"type":"number","minimum":0,"maximum":1},
              "typography_fit":{"type":"number","minimum":0,"maximum":1},
              "asset_truth_fit":{"type":"number","minimum":0,"maximum":1},
              "format_resilience":{"type":"number","minimum":0,"maximum":1},
              "lighting_fit":{"type":"number","minimum":0,"maximum":1},
              "currentness":{"type":"number","minimum":0,"maximum":1}
            }
          },
          "attention_plan": {"type":"object","minProperties":1},
          "typography_plan": {"type":"object","minProperties":1},
          "lighting_affinity": {"type":"array","items":{"type":"string","minLength":1}},
          "rationale": {"type":"array","minItems":2,"items":{"type":"string","minLength":1}},
          "risk_flags": {"type":"array","items":{"type":"string","minLength":1}},
          "performance_claim": {"const":"NO_PERFORMANCE_PREDICTION"}
        }
      }
    },
    "policy": {
      "type":"object",
      "additionalProperties": false,
      "required":["currentness_weight_cap","top3_are_decision_support","art_director_approval_required"],
      "properties": {
        "currentness_weight_cap":{"type":"number","minimum":0,"maximum":0.1},
        "top3_are_decision_support":{"const":true},
        "art_director_approval_required":{"const":true}
      }
    }
  }
}
