{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GeneralAi360/googlewads/schemas/visual-review-report.schema.json",
  "title": "Visual Review Eval Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "reviewer_context", "artifact_paths", "summary", "findings"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^VR-[0-9]{2}$"},
    "reviewer_context": {"const": "fresh_read_only_visual"},
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "summary": {"type": "string"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "code", "evidence", "why_it_matters", "recommended_fix", "scope"],
        "properties": {
          "severity": {"enum": ["CRITICAL", "IMPORTANT", "MINOR"]},
          "code": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "why_it_matters": {"type": "string", "minLength": 1},
          "recommended_fix": {"type": "string", "minLength": 1},
          "scope": {"enum": ["single_banner", "pack"]}
        }
      }
    }
  }
}
